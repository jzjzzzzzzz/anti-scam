# Reference only. Do not commit real .env files or keys.
# Lambda environment variables are set by the CloudFormation templates.
AWS_REGION=us-east-1
SENDER=noreply@example.com
ALLOWED_RECIPIENT=recipient@example.com
EMAIL_PROVIDER=resend
# ARN only; the Resend API key belongs in Secrets Manager, not in frontend code.
RESEND_SECRET_ARN=
